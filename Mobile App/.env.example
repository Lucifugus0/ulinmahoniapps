# Staging API (untuk branch staging)
BASE_URL=https://api.example.com/api/v1
API_KEY=your_api_key_here

# Android Keystore Fingerprints
# SHA-1 (for Google Sign-In OAuth)
SHA1_DEBUG=your_debug_sha1_here
SHA1_RELEASE=your_release_sha1_here

# SHA-256 (for Apple Sign-In Service ID)
SHA256_DEBUG=your_debug_sha256_here
SHA256_RELEASE=your_release_sha256_here

# Apple Sign-In P8 Key (for backend server-to-server auth)
APPLE_P8_KEY=your_apple_p8_key_here

# App Identifiers
IOS_IDENTIFIER=com.example.app
ANDROID_IDENTIFIER=com.example.app

# App Versioning
VERSION_CODE=1
VERSION_NAME=1.0.0
